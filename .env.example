# Set only in local/deployment secret storage; never commit real credentials.
AWS_REGION=ap-south-1
NODE_ENV=development
DYNAMODB_TABLE=marketplace-workflow-test
DYNAMODB_ENDPOINT=http://localhost:8000
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Comma-separated HTTPS hosts used for seller-uploaded product media.
PRODUCT_IMAGE_HOSTS=
# Cloudflare R2 server-side credentials and bucket configuration for seller image uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public HTTPS base URL for the bucket, such as an operator-owned R2 custom domain.
R2_PUBLIC_BASE_URL=
# Private AWS S3 bucket for identity documents (never use a public product-media bucket).
KYC_DOCUMENT_BUCKET=
# Generate a dedicated 32-byte key and store it in local/deployment secret storage.
KYC_DATA_ENCRYPTION_KEY=
# Explicit LOCAL-ONLY workflow mode. Set true only with marketplace-workflow-test and DynamoDB Local.
LOCAL_WORKFLOW_TESTING=false
# Generate a random 32-byte key for local KYC encryption; never reuse production keys.
LOCAL_KYC_TEST_KEY=
# Use only once for an operator-controlled initial bootstrap, then remove.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
