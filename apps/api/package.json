{
  "name": "@marketplace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "db:local:setup": "node --env-file=../../.env --import tsx src/create-local-table.ts",
    "db:catalog-search:backfill": "node --env-file=../../.env --import tsx src/backfill-catalog-search.ts",
    "db:bootstrap-admin": "node --env-file=../../.env --import tsx src/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --env-file=../../.env --import tsx --test src/server.test.ts src/catalog-search.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.2.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
